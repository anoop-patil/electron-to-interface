# Cloudflare Pages reads this file. Each path below changes whenever its contents do (Vite puts a hash in assets/
# names, and Pyodide's files sit under their version), so browsers may keep them for a year. Everything else gets
# Pages' default, which makes the browser check for a newer copy on every visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/pyodide/*
  Cache-Control: public, max-age=31536000, immutable
